<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wallpaper_Switch.UI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Wallpaper Switch.UI/Assets/Styles/StylesNavBtn.axaml"/>
        <StyleInclude Source="avares://Wallpaper Switch.UI/Assets/Styles/StylesTimers.axaml"/>
    </Application.Styles>
</Application>
