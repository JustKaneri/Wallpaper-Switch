<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="785" d:DesignHeight="550"
             x:Class="Wallpaper_Switch.UI.AutoView">
    <StackPanel Margin="30 15 30 0" Background="#10171e" >
        <TextBlock Margin="0 0 0 0" FontSize="18" Foreground="White"  VerticalAlignment="Center" >Автоматизация</TextBlock>
        <TextBlock Margin="0 5 0 0" FontSize="13" Foreground="Gray"  VerticalAlignment="Center" >Настройте автоматическую смену обоев</TextBlock>
        <Border Margin="0 20 0 0" BorderBrush="#252d36" BorderThickness="2" CornerRadius="15" ClipToBounds="True" Grid.Row="1" Grid.ColumnSpan="3">
            <StackPanel  Background="#171f27">
                <Grid ColumnDefinitions="600 *" RowDefinitions="40 50 20 100" ShowGridLines="True">
                    <TextBlock Grid.Column="0" Grid.Row="0" Margin="15 15 0 0" Foreground="White" FontSize="15">Автоматическая смена обоев</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="15 0 0 0" FontSize="13" Foreground="Gray">Приложение будет автоматически устанавливать новые обои<LineBreak />
                        чреез заданный промежуток времени
                    </TextBlock>
                    <ToggleSwitch Grid.Column="1" Grid.Row="0"/>
                    <TextBlock Grid.Column="0" Grid.Row="2" Margin="15 10 0 10" Foreground="White">Интервал смены</TextBlock>
                    <StackPanel Margin="15 0 15 0" Spacing="17" Grid.ColumnSpan="2" Grid.Row="3" Orientation="Horizontal" >
                        <Button Classes="timer-item" Cursor="Hand" Name="Btn1m" Tag="60" Click="TimerSelector_Click" CornerRadius="10" Width="70" Height="70"  HorizontalAlignment="Stretch" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <PathIcon  Data="{StaticResource timer_regular}" Width="25" Height="25" />
                                <TextBlock FontSize="15" Foreground="#F5F7FA" Text="1 мин" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="timer-item" Cursor="Hand" Name="Btn5m" Tag="300" Click="TimerSelector_Click" CornerRadius="10" Width="70" Height="70"  HorizontalAlignment="Stretch" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <PathIcon  Data="{StaticResource timer_regular}" Width="25" Height="25" />
                                <TextBlock FontSize="15" Foreground="#F5F7FA" Text="5 мин" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="timer-item" Cursor="Hand" Name="Btn15m" Tag="900" Click="TimerSelector_Click" CornerRadius="10" Width="70" Height="70"  HorizontalAlignment="Stretch" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <PathIcon  Data="{StaticResource timer_regular}" Width="25" Height="25" />
                                <TextBlock FontSize="15" Foreground="#F5F7FA" Text="15 мин" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="timer-item" Cursor="Hand" Name="Btn30m" Tag="1800" Click="TimerSelector_Click" CornerRadius="10" Width="70" Height="70"  HorizontalAlignment="Stretch" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <PathIcon  Data="{StaticResource timer_regular}" Width="25" Height="25" />
                                <TextBlock FontSize="15" Foreground="#F5F7FA" Text="30 мин" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="timer-item" Cursor="Hand" Name="Btn60m" Tag="3600" Click="TimerSelector_Click" CornerRadius="10" Width="70" Height="70"  HorizontalAlignment="Stretch" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <PathIcon  Data="{StaticResource timer_regular}" Width="25" Height="25" />
                                <TextBlock FontSize="15" Foreground="#F5F7FA" Text="60 мин" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="timer-item" Cursor="Hand" Name="Btn2h" Tag="7200" Click="TimerSelector_Click" CornerRadius="10" Width="70" Height="70"  HorizontalAlignment="Stretch" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <PathIcon  Data="{StaticResource timer_regular}" Width="25" Height="25" />
                                <TextBlock FontSize="15" Foreground="#F5F7FA" Text="2 часа" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="timer-item" Cursor="Hand" Name="Btn3h" Tag="10800" Click="TimerSelector_Click" CornerRadius="10" Width="70" Height="70"  HorizontalAlignment="Stretch" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <PathIcon  Data="{StaticResource timer_regular}" Width="25" Height="25" />
                                <TextBlock FontSize="15" Foreground="#F5F7FA" Text="3 часа" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="timer-item" Cursor="Hand" Name="Btn6h" Tag="21600" Click="TimerSelector_Click" CornerRadius="10" Width="70" Height="70"  HorizontalAlignment="Stretch" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <PathIcon  Data="{StaticResource timer_regular}" Width="25" Height="25" />
                                <TextBlock FontSize="15" Foreground="#F5F7FA" Text="6 часа" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
