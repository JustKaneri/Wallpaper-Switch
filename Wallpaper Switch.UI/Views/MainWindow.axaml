<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wallpaper_Switch.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Wallpaper_Switch.UI.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
        x:Class="Wallpaper_Switch.UI.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        ExtendClientAreaChromeHints="PreferSystemChrome, NoChrome"
        Title="Wallpaper Switch"
        Background="#0F1115"
        Width="800"
        Height="600"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
        <views:MainView />
        <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Assets/AppResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
</Window>
